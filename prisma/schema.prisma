generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  name          String?
  role          Role         @default(BUYER)
  createdAt     DateTime     @default(now())

  phone         String?
  contactPref   String?
  whatsapp      String?
  telegram      String?

  listings      Listing[]
  savedListings SavedListing[]
  sessions      Session[]
  accounts      Account[]
  notifications Notification[]
  photos        ListingPhoto[]
  documents     OwnerDocument[]
  contracts     TenancyContract[]
}

enum Role {
  GUEST
  BUYER
  AGENT
}

model Listing {
  id            String          @id @default(cuid())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  expiresAt     DateTime

  status        ListingStatus   @default(ACTIVE)
  listingType   ListingType     @default(SALE)

  title         String
  projectName   String
  location      String
  subLocation   String?

  propertyType  PropertyType
  bedrooms      String
  bathrooms     String?

  areaSqft      Float?
  areaSqm       Float?
  plotSqft      Float?
  plotSqm       Float?

  price         Float
  priceLabel    String?

  floor         FloorType?
  view          String?
  furnished     FurnishedStatus?

  handover      String?
  handoverDate  DateTime?

  isDistress    Boolean         @default(false)
  originalPrice Float?

  parkingSpots  Int?
  isRented      Boolean         @default(false)
  rentAmount    Float?
  rentedUntil   String?
  occupancy     Occupancy?
  chequeCount   Int?
  availableFrom DateTime?

  description   String?
  viewCount     Int             @default(0)

  agentId       String
  agent         User            @relation(fields: [agentId], references: [id])

  savedBy       SavedListing[]
  notifications Notification[]
  photos        ListingPhoto[]
  documents     OwnerDocument[]
  review        ListingReview?
  contracts     TenancyContract[]
}

// Kept out of Listing so that no public query can return these by accident.
model ListingReview {
  listingId      String    @id
  propertyNumber String
  amountPaid     Float?
  checks         String?
  note           String?
  reviewedAt     DateTime?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

// Encrypted files live on disk at <DOCUMENTS_DIR>/<id>.enc and are only served
// through the admin area. listingId stays null for identity documents, and for
// title deeds until the listing is submitted.
model OwnerDocument {
  id         String       @id
  createdAt  DateTime     @default(now())
  kind       DocumentKind
  mimeType   String
  fileName   String
  sha256     String
  deedNumber String?
  uploaderId String
  listingId  String?

  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  listing  Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([uploaderId, kind])
  @@index([listingId])
  @@index([sha256])
  @@index([deedNumber])
}

enum DocumentKind {
  TITLE_DEED
  PASSPORT
  EMIRATES_ID
  TENANCY_CONTRACT
}

// The PDF is an OwnerDocument with no listing, so deleting a listing keeps a signed
// contract. Only a hash of the tenant's link is stored.
model TenancyContract {
  id             String         @id @default(cuid())
  createdAt      DateTime       @default(now())
  status         ContractStatus @default(AWAITING_TENANT)
  ownerId        String
  listingId      String?
  documentId     String
  tenantEmail    String
  tenantName     String?
  tokenHash      String         @unique
  linkExpiresAt  DateTime
  ownerSignedAt  DateTime?
  tenantSignedAt DateTime?
  tenantIp       String?
  pdfSha256      String?

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([listingId])
}

enum ContractStatus {
  AWAITING_TENANT
  AWAITING_OWNER
  COMPLETED
}

enum Occupancy {
  VACANT
  RENTED
  OFFPLAN
}

// Files live on disk at <UPLOAD_DIR>/<id>.webp and <id>-thumb.webp.
// listingId stays null between upload and publish.
model ListingPhoto {
  id         String   @id
  createdAt  DateTime @default(now())
  position   Int      @default(0)
  uploaderId String
  listingId  String?

  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  listing  Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
  @@index([uploaderId, listingId])
}

enum ListingStatus {
  ACTIVE
  RESERVED
  SOLD
  EXPIRED
  PENDING_REVIEW
  REJECTED
}

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  TOWNHOUSE
  VILLA
  PENTHOUSE
  DUPLEX
}

enum FloorType {
  LOW
  MIDDLE
  HIGH
}

enum FurnishedStatus {
  FURNISHED
  UNFURNISHED
  PARTIAL
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  listingId String?
  type      NotifType
  message   String
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
}

enum NotifType {
  LISTING_EXPIRING
  LISTING_EXPIRED
  CONTACT_REVEALED
  LISTING_APPROVED
  LISTING_REJECTED
  CONTRACT_SIGNED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
